# Copie para ".env" (na raiz) e preencha SOMENTE o que for usar.
# Sem nada preenchido, o app sobe com os alimentos do arquivo TACO local.

# Porta do site no seu computador
WEB_PORT=8080

# --- Supabase (login, perfil, receitas, favoritos) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Alimentos ---
# taco = arquivo local | postgres = tabela public.alimentos do Supabase
ALIMENTOS_SOURCE=taco
DATABASE_URL=
# supabase | rapidapi  (qual fonte o React usa)
VITE_ALIMENTOS_SOURCE=supabase

# --- RapidAPI (opcional) ---
RAPIDAPI_KEY=
RAPIDAPI_HOST=taco-api-br1.p.rapidapi.com
