{
  "name": "que-fome-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "import:taco": "tsx scripts/importar-taco.ts",
    "test:auth": "tsx --test test/supabase-auth.guard.spec.ts test/supabase-auth.service.spec.ts test/profiles.spec.ts",
    "test:recipes": "tsx --test test/recipes.spec.ts test/recipe-tags-catalog.spec.mjs test/receitas-oficiais-nutricao.test.mjs",
    "test:api": "node scripts/testar-api.mjs",
    "test:supabase": "node scripts/testar-supabase.mjs",
    "test:rapidapi": "node scripts/testar-rapidapi.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
