    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,mjs}\" \"backend/src/**/*.{js,jsx,ts,tsx,mjs}\" \"backend/scripts/**/*.{js,jsx,ts,tsx,mjs}\" \"vite.config.js\""
